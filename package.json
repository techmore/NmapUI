{
  "name": "gemini-nmap",
  "version": "1.0.0",
  "description": "Nmap Network Scanner GUI",
  "main": "packaging/macos/run.sh",
  "scripts": {
    "prestart": "node scripts/ensure-dependencies.js",
    "start": "cd packaging/macos && ./run.sh",
    "test:google-drive-helper-unavailable": "node scripts/test_google_drive_helper_unavailable.js",
    "nightly-eval": "./scripts/nightly_product_eval.sh --run",
