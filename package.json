    "nightly-eval:launchd-install": "./packaging/macos/nightly_product_eval_launchd.sh install",
    "nightly-eval:launchd-uninstall": "./packaging/macos/nightly_product_eval_launchd.sh uninstall"
  },
  "dependencies": {
